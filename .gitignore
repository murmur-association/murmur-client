# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
# CI caches: the pinned Flutter SDK and the fallback fonts (.gitlab-ci.yml).
/.flutter-sdk/
/.font-cache/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# The macOS folder: generated with `flutter create .` if ever needed, not kept
# (the desktop client for macOS is out of scope). windows/, linux/, ios/ and
# android/ are, with the app's name, identifier and icon.
/macos/

# Keys and local node data never belong here.
*.key
murmur-data/

# Release archives made locally (tool/package_desktop.dart).
/dist/
